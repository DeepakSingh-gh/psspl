NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
CRM_DATABASE_PATH=./data/crm.sqlite
APP_BASE_URL=http://localhost:3000
CRM_ADMIN_EMAIL=admin@example.local
CRM_ADMIN_PASSWORD=change-this-local-password
CRM_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
CRM_EMAIL_QUEUE_KEY=
# Enable only when the frontend and Express API share a same-site HTTPS origin.
CRM_SESSION_COOKIE_ENABLED=false

# Ask AI — backend only (also set these in the Render service environment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback provider
OPENAI_API_KEY=

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=


