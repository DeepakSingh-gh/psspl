NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
CRM_DATABASE_PATH=./data/crm.sqlite
APP_BASE_URL=http://localhost:3000
CRM_ADMIN_EMAIL=admin@example.local
CRM_ADMIN_PASSWORD=change-this-local-password
CRM_EMAIL_PROVIDER=disabled
# Select smtp for Gmail, resend for the existing provider, or disabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# With SMTP, EMAIL_FROM must be the authenticated SMTP_USER address.
# Localhost account/reset links may ONLY go to this local tester (defaults to SMTP_USER).
CRM_EMAIL_LOCAL_TEST_RECIPIENT=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
CRM_EMAIL_QUEUE_KEY=
# Enable only when the frontend and Express API share a same-site HTTPS origin.
CRM_SESSION_COOKIE_ENABLED=false

# Webinar-only sample customers, invoices, visits, leads, and follow-ups.
# Keep disabled for normal production use; sample rows are visibly marked [Demo].
CRM_ENABLE_WEBINAR_DEMO_DATA=false

# Ask AI — backend only (also set these in the Render service environment)
CRM_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Existing local "Claude api key" and CLAUDE_API_KEY are also accepted server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback provider
OPENAI_API_KEY=

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_NUMBER=


