{
  "name": "psspl-crm",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node dev-runner.mjs",
    "build": "next build",
    "start": "node dev-runner.mjs --production",
    "start:api": "node server/app.mjs",
    "import:data": "py -3.11 scripts/import_psspldata.py C:\\Users\\deepa\\Downloads\\psspldata",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-development.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:backup": "node scripts/backup-sqlite.mjs backup",
    "db:restore": "node scripts/backup-sqlite.mjs restore",
    "test:security": "node --test scripts/phase1-security.test.mjs",
    "test:rm-feedback": "node --test scripts/rm-feedback.test.mjs",
    "test:phase2": "node --test scripts/phase2-tally-accuracy.test.mjs",
    "test:phase3": "node --test scripts/phase3-rm-report.test.mjs",
    "test:phase4": "node --test scripts/phase4-management.test.mjs",
    "test:phase5": "node --test scripts/phase5-field-workflows.test.mjs",
    "test:phase6": "node --test scripts/phase6-leads.test.mjs scripts/phase6-reports.test.mjs && node scripts/phase6-my-day.test.mjs",
    "test:phase7": "node --test scripts/phase7-automation.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "multer": "^2.4.0",
    "next": "^15.5.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.34.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
