{
  "name": "psspl-crm",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node dev-runner.mjs",
    "build": "next build",
    "start": "node dev-runner.mjs --production",
    "start:api": "node server/app.mjs",
    "import:data": "python scripts/import_excel_data.py",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-development.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
